# ==========================================
# FableSTEM Backend Configuration
# ==========================================

# Groq API Configuration
# Get your API key from Groq Console: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=gpt-oss-120b

# Alternative Google Gemini API Key (Optional fallback)
GEMINI_API_KEY=

# PostgreSQL Database Connection URL
# Format: postgresql://username:password@host:port/database_name
# e.g., postgresql://postgres:mypassword@localhost:5432/fablestem
# e.g., Neon / Supabase: postgresql://user:pass@ep-cool-fog.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/fablestem

# Server Port
PORT=8000
